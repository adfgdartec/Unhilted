prompt = "Look"
title = "LOOKOUT"
lore_id = "spire_lookout"
lines = Array[String](["> You put your eye to the telescope.", "Past the heap, the megacity runs to the edge of the sky. Every light in it leans toward one tower: the Spire.", "Something at its top is pulling. The smog drifts toward it like water toward a drain.", "> Your blade hums, very faintly, while you look."])
