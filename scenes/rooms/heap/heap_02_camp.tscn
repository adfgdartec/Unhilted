[node name="GranOxa" parent="." instance=ExtResource("4_npc")]
position = Vector2(588, 336)
npc_id = &"gran_oxa"
display_name = "Gran Oxa"
idle_lines = Array[String](["Sit, sit. Fire's free. Talk's cheap, and I'm cheaper.", "Everybody in this camp is my grandkid, near enough. Same goggles, same bad knees. Runs in the family.", "That big brass face out past the crane? It was there before the city. My gran swore it used to hum on cold nights."])
lineage = ExtResource("lin_heap")
age = "elder"
pin_headwear = "none"
pin_goggles = "single"
pin_accessory = "cane"

[node name="Sprocket" parent="." instance=ExtResource("4_npc")]
position = Vector2(146, 336)
npc_id = &"sprocket"
display_name = "Sprocket"
idle_lines = Array[String](["Don't stand there, you're blocking my view of the Intake.", "Somebody's gotta watch the crane. It dumps twice a night. You learn the rhythm or you get buried.", "Gran says {they}'s older than her. That can't be right. Nobody's older than Gran."])
lineage = ExtResource("lin_heap")
age = "teen"
pin_headwear = "beanie"
pin_goggles = "double"
