[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/resources/quest_objective.gd" id="2_obj"]

[sub_resource type="Resource" id="obj_1"]
script = ExtResource("2_obj")
type = 0
target_id = &"letter"
count = 3
description = "Find the lost letters"

[resource]
script = ExtResource("1_script")
id = &"letters_home"
title = "Letters Home"
description = "When Line 4 stopped running, the last mail tram never came in. Its letters are scattered through the tunnels. Postmistress Hale wants them delivered, sixty years late."
region_id = &"underworks"
giver_name = "Postmistress Hale"
objectives = Array[ExtResource("2_obj")]([SubResource("obj_1")])
reward_scrap = 20
reward_local = 6
reward_chips = Array[StringName]([])
reward_cosmetics = Array[StringName]([&"cloak_bellows"])
offer_lines = Array[String](["Post office's closed. Has been for sixty years. I keep it tidy anyway.", "When Line 4 went dark, the last mail tram was somewhere down the line. It never came in.", "The letters are still out there. I've found a few in the Cistern, the old tunnel, the Gauge Hall. I'm too old to go looking for the rest.", "Find three. People are still waiting. Well. Their grandchildren are."])
active_lines = Array[String](["Three letters. Try the Cistern, the Old Tram Tunnel and the Pressure Gauge Hall. Mind the water."])
complete_lines = Array[String](["Oh. Oh, that's Mrs. Fenn's handwriting. Her great-grandson lives two doors down.", "Here. This was the uniform coat. It's too long for me and it was always too long for me. It'll suit you."])
done_lines = Array[String](["I delivered them all. One family cried. One family laughed. One family said 'who?'", "Sixty years is a long time for a letter. Not so long for a promise."])
