script = ExtResource("1_lin")
id = &"heapfolk"
display_name = "Heapfolk"
shared_traits = "Generations of scavengers on the Heap. Hunched, bundled silhouette; round heads; patchwork coats all stitched with the same centre seam; oversized boots; and the family signature: amber-lensed goggles that glow faintly at dusk. Coats are cut from the same salvaged cloth, so they share a dusty brown/olive range, patched with container green, rust and canvas."
